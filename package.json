{
  "name": "chta",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "dotenv -e .env.local -- drizzle-kit migrate",
    "db:seed": "dotenv -e .env.local -- tsx scripts/seed.ts",
    "db:studio": "dotenv -e .env.local -- drizzle-kit studio",
    "test": "vitest run --project unit",
    "test:integration": "dotenv -e .env.test -- vitest run --project integration",
    "test:all": "npm run test && npm run test:integration",
    "db:reset": "dotenv -e .env.local -- tsx scripts/reset-dev.ts && npm run db:seed -- --demo",
    "test:e2e": "playwright test",
    "vercel-build": "tsx scripts/release.ts && next build",
    "release": "tsx scripts/release.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1169.0",
    "@node-rs/argon2": "^2.2.2",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.4",
    "exceljs": "^4.4.0",
    "lucide-react": "^1.72.0",
    "next": "15.5.29",
    "otplib": "^13.6.0",
    "pdf-lib": "^1.17.1",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "server-only": "^0.0.1",
    "stripe": "^17.7.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/eslintrc": "^3",
    "@playwright/test": "1.56",
    "@tailwindcss/postcss": "^4",
    "@types/autocannon": "^7.12.7",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autocannon": "^8.0.0",
    "dotenv-cli": "^11.1.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "15.5.29",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^3.2.7"
  },
  "overrides": {
    "uuid": "^11.1.1"
  },
  "engines": {
    "node": "22.x"
  }
}
