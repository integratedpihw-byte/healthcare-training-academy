# ---------------------------------------------------------------------------
# COMPLETE HEALTHCARE INNOVATIVE TRAINING ACADEMY — environment variables
# Copy to .env.local (development) and set real values in your host's secret store.
# NEVER expose any of these to the browser (no NEXT_PUBLIC_ prefix on secrets).
# ---------------------------------------------------------------------------

# Runtime role (NOBYPASSRLS). All tenant queries run through row-level security.
DATABASE_URL=postgres://chta_app:CHANGE_ME@localhost:5432/chta
# Platform role (BYPASSRLS): auth, super-admin console, jobs, webhooks, public verification.
SYSTEM_DATABASE_URL=postgres://chta_system:CHANGE_ME@localhost:5432/chta
# Schema owner: migrations only. Not needed by the running app.
MIGRATION_DATABASE_URL=postgres://chta_owner:CHANGE_ME@localhost:5432/chta

# Public base URL (used in certificate verification links / QR codes and emails).
APP_URL=http://localhost:3000

# 32+ random bytes, base64. Encrypts MFA secrets at rest (AES-256-GCM).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=CHANGE_ME

# Session lifetime in hours (idle sessions also expire after SESSION_IDLE_MINUTES).
SESSION_TTL_HOURS=12
SESSION_IDLE_MINUTES=60

# Email (Phase 4)
EMAIL_PROVIDER=console            # console | resend | postmark | ses
EMAIL_FROM="Complete Healthcare Innovative Training Academy <no-reply@example.com>"
RESEND_API_KEY=

# Billing (Phase 6). Leave STRIPE_SECRET_KEY empty to disable online checkout; platform
# administrators can still set plans manually. Webhook endpoint: POST /api/webhooks/stripe
# (events: checkout.session.completed, customer.subscription.*, invoice.*).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# One recurring Price per plan and cycle (create them in the Stripe dashboard).
STRIPE_PRICE_STARTER_MONTHLY=
STRIPE_PRICE_STARTER_ANNUAL=
STRIPE_PRICE_PROFESSIONAL_MONTHLY=
STRIPE_PRICE_PROFESSIONAL_ANNUAL=
STRIPE_PRICE_ENTERPRISE_MONTHLY=
STRIPE_PRICE_ENTERPRISE_ANNUAL=

# AI education assistant (Phase 6). Server-side only. Empty = assistant shows "not configured".
# Sign a BAA-appropriate agreement with the provider if staff could enter PHI; the app blocks
# PHI-like input and never stores prompts or answers, but defense in depth is best practice.
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5-5
AI_HOURLY_LIMIT=30
# AI_PROVIDER=fake is for automated tests only (refused in production unless ALLOW_FAKE_AI=1).

# File uploads (Phase 7). Production: private S3-compatible bucket (block public access).
STORAGE_DRIVER=s3                 # s3 | local (local is refused in production)
S3_BUCKET=
S3_REGION=us-east-1
S3_ENDPOINT=                      # set for R2/B2/MinIO; leave empty for AWS
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
UPLOAD_MAX_MB=10                  # license documents and competency evidence
UPLOAD_MAX_MEDIA_MB=50            # lesson media (Vercel functions accept ~4.5 MB bodies — see DEPLOYMENT.md)
# Malware scanning (ClamAV clamd). Recommended: UPLOAD_REQUIRE_SCAN=1 in production.
CLAMAV_HOST=
CLAMAV_PORT=3310
UPLOAD_REQUIRE_SCAN=0

# Optional SMS for critical alerts (Phase 7). console = log only.
SMS_PROVIDER=console              # console | twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=               # or TWILIO_MESSAGING_SERVICE_SID
TWILIO_MESSAGING_SERVICE_SID=

# Shared secret for scheduled jobs (/api/cron/*). Vercel Cron sends it automatically when set.
CRON_SECRET=CHANGE_ME

# Platform administrators must use two-step verification. Set to "optional" only in test environments.
PLATFORM_ADMIN_MFA=required
# Shown to users on help, error and legal pages.
SUPPORT_EMAIL=support@example.org
# Legal entity named in the Terms of Service and Privacy Policy.
LEGAL_ENTITY_NAME=
